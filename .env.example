# Local development defaults for TIM
# Do not store real credentials here.

TIM_SERVER_HTTP_PORT=8082
TIM_SERVER_NETTY_PORT=9002
TIM_SERVER_ID=im-server-1
TIM_NODE_ID=1
TIM_GATEWAY_HTTP_PORT=8090
TIM_CLIENT_HTTP_PORT=8003

TIM_REDIS_HOST=127.0.0.1
TIM_REDIS_PORT=6379
TIM_ZOOKEEPER_ADDR=127.0.0.1:2181

TIM_GATEWAY_URL=http://localhost:8090/
TIM_MYSQL_URL=jdbc:mysql://127.0.0.1:3306/tim?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
TIM_MYSQL_USER=tim
TIM_MYSQL_PASSWORD=tim
TIM_MQ_MODE=local
TIM_ROCKETMQ_NAMESRV=127.0.0.1:9876
